{
    "version": 1,
    "disable_existing_loggers": true,
    "root": {
        "handlers": ["console", "file"],
        "level": "DEBUG"
    },
    "loggers": {
        "app": {
            "handlers": ["console", "file"],
            "propagate": false
        },
        "route": {
            "handlers": ["route_console", "route_file"],
            "propagate": false
        }
    },
    "handlers": {
        "console": {
            "formatter": "std_out",
            "class": "logging.StreamHandler"
        },
        "file": {
            "formatter": "std_out",
            "class": "logging.handlers.WatchedFileHandler",
            "filename": "/tmp/backend.log"
        },
        "route_console": {
            "formatter": "route_out",
            "class": "logging.StreamHandler"
        },
        "route_file": {
            "formatter": "route_out",
            "class": "logging.handlers.WatchedFileHandler",
            "filename": "/tmp/route.log"
        }
    },
    "formatters": {
        "std_out": {
            "format": "%(asctime)s : %(levelname)s : %(module)s : %(funcName)s : %(message)s",
            "datefmt": "%d-%m-%Y %H:%M:%S"
        },
        "route_out": {
            "format": "%(asctime)s : %(levelname)s : route : %(message)s",
            "datefmt": "%d-%m-%Y %H:%M:%S"
        }
    }
}